# E2E Test Configuration
# Copy this file to .env.e2e and fill in the values
# NEVER commit .env.e2e (it contains secrets)

# Target URL for tests (staging or local)
E2E_BASE_URL=https://memopyk.memopyk.com

# Admin credentials
E2E_ADMIN_PASSWORD=your-admin-password-here

# Optional: for future email-based auth
# E2E_ADMIN_EMAIL=admin@example.com
