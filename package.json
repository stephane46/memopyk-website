{
  "name": "memopyk-website",
  "version": "2.0.0",
  "description": "MEMOPYK - Memory preservation service website",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --mode production",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server/index.js --external:pg-native --external:sharp --packages=external",
    "start": "node dist/server/index.js",
    "preview": "npm run build && npm run start",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
